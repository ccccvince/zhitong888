# 智瞳量化 · 生产环境配置示例 (请复制为 .env 并修改密钥)
TZ=Asia/Shanghai
PAPER_TRADE_DB=data/paper_trade.db
SITE_URL=https://zhitong888.ccwu.cc

# 登录鉴权控制
AUTH_REQUIRED=true
INVITE_REQUIRED=false
EMAIL_VERIFICATION_REQUIRED=false

# 邮件通道配置（Brevo、Resend 或 SMTP 三选一，Brevo 每日 300 封免费额度）
# 方式 1: Brevo (推荐，官网免费获取 api-key，格式如 xkeysib-...)
BREVO_API_KEY=
# 方式 2: Resend (格式如 re_...)
RESEND_API_KEY=
# 方式 3: 传统 SMTP (支持 Sendflare / 163 / QQ 等)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 发件人显示（在邮件服务商认证域名后填写）
EMAIL_FROM=智瞳量化 <noreply@yourdomain.com>

# 公网 SSRF 防护（生产环境必须保持 false）
ALLOW_PRIVATE_AI_ENDPOINTS=false
ALLOW_PRIVATE_WEBHOOKS=false

# Session 签名密钥（建议使用 openssl rand -hex 32 生成随机字符串）
APP_SECRET_KEY=replace-with-long-random-secret

# 初始管理员账号（首次启动自动创建；之后可在页面「账户中心」修改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# 可选：全站公共试用大模型额度（不填则新用户使用本地量化摘要，或在界面配置自己的 API Key）
PUBLIC_AI_PROVIDER=智瞳公共体验 AI
PUBLIC_AI_BASE_URL=
PUBLIC_AI_MODEL=
PUBLIC_AI_API_KEY=
PUBLIC_AI_DAILY_LIMIT=10
